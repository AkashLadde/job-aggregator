# Copy this file to `.env` for local testing. Never commit the real `.env`.

# Database (defaults to local SQLite file if omitted)
DATABASE_URL=sqlite:///job_aggregator.db

# Gmail SMTP (use an App Password, not your real password)
# Generate at: https://myaccount.google.com/apppasswords (requires 2FA enabled)
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_RECIPIENT=youraddress@gmail.com

# Twilio WhatsApp
# Sandbox quick-start: https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# Optional: public URL of today's PDF if you host it, so WhatsApp can attach it as media
PDF_PUBLIC_URL=
