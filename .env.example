# Copy this file to `.env` for local testing. Never commit the real `.env`.
# Every job source is optional: a source whose key is blank is simply skipped.

# ---------------- Job sources ----------------
# 1) Adzuna (free, ~250 calls/day): https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# 2) JSearch = Google for Jobs -> LinkedIn, Naukri, Indeed, Glassdoor, Foundit postings
#    Free plan ~200 requests/month. Key from rapidapi.com (search "JSearch", subscribe
#    to the free Basic plan) or from openwebninja.com.
JSEARCH_API_KEY=
JSEARCH_PROVIDER=rapidapi          # or: openwebninja

# 3) Jooble (free, 500 requests per key in TOTAL): request at https://jooble.org/api/about
JOOBLE_API_KEY=

# 4) Company career boards - no key. "platform:slug:Name", comma separated.
COMPANY_BOARDS=lever:cred:CRED,lever:meesho:Meesho,lever:paytm:Paytm,greenhouse:groww:Groww

# 5) Government / PSU notifications via RSS - no key.
RSS_FEEDS=https://www.freejobalert.com/feed/

# ---------------- Email (Gmail App Password, not your real password) ----------------
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_RECIPIENT=youraddress@gmail.com      # several: a@x.com,b@y.com

# ---------------- Fresher filter ----------------
JOB_COUNTRIES=in                 # India only (Adzuna codes; e.g. in,ae,sg)
# Batch years, e.g. 2025,2026,2027 (blank = last year, this year, next year)
FRESHER_BATCH_YEARS=
FRESHER_STRICT=true              # false = also include jobs that never mention experience
FRESHER_MAX_EXPERIENCE=0

# ---------------- Free-quota guards (defaults shown) ----------------
JSEARCH_REQUESTS_PER_RUN=3       # morning run only -> ~90/month
JSEARCH_MONTHLY_LIMIT=95
JOOBLE_REQUESTS_PER_RUN=1        # morning run only -> ~30/month
JOOBLE_TOTAL_LIMIT=480

DATABASE_URL=sqlite:///job_aggregator.db
